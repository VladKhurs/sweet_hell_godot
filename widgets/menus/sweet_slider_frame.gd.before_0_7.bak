extends PanelContainer
class_name SweetSliderFrame

# Use the central SweetUI palette: changing sweet_ui_config.tres updates this frame.
func _ready() -> void:
    texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
    add_theme_stylebox_override("panel", SweetUI.make_box(
        SweetUI.CONFIG.background, SweetUI.CONFIG.border, -1, -1, 6, 5))
    var slider := get_child(0) as HSlider
    if slider == null:
        return
    slider.custom_minimum_size.y = 15
    slider.add_theme_stylebox_override("slider", SweetUI.make_box(
        SweetUI.CONFIG.disabled, SweetUI.CONFIG.border, 1, 1, 0, 0))
    slider.add_theme_stylebox_override("grabber_area", SweetUI.make_box(
        SweetUI.CONFIG.button, SweetUI.CONFIG.border, 1, 1, 0, 0))
    slider.add_theme_stylebox_override("grabber_area_highlight", SweetUI.make_box(
        SweetUI.CONFIG.hover, SweetUI.CONFIG.border, 1, 1, 0, 0))
    var knob := Image.create(9, 13, false, Image.FORMAT_RGBA8)
    knob.fill(SweetUI.CONFIG.border)
    for y in range(2, 11):
        for x in range(2, 7):
            knob.set_pixel(x, y, SweetUI.CONFIG.button)
    var tex := ImageTexture.create_from_image(knob)
    slider.add_theme_icon_override("grabber", tex)
    slider.add_theme_icon_override("grabber_highlight", tex)
