; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="sweet_hell"
run/main_scene="res://widgets/menus/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

DialogueManager="*uid://c3rodes2l3gxb"
Game="*uid://bpvaim5o7jso2"
GameState="*uid://dtanqguql8co8"
Inventory="*uid://du38vmgn35blr"
SweetUI="*res://assets/themes/sweet_ui.gd"
SettingsManager="*res://core/settings_manager.gd"
PauseManager="*res://core/pause_manager.gd"
MusicManager="*res://core/music_manager.gd"
SaveManager="*res://core/save_manager.gd"

[dialogue_manager]

runtime/balloon_path="res://widgets/dialogue/sweet_dialogue_balloon.tscn"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/parallax2d_preview/plugin.cfg")

[gui]

theme/custom="res://assets/themes/sweet_hell_theme.tres"

